<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Здоровое питание для собак</title>
<meta name="theme-color" content="#2e7d32">
<style>
:root{--fg:#1b262c;--muted:#7b8788;--line:#e4e8eb;--soft:#f4f7f6;--acc:#2e7d32;--rad:14px;--shadow:0 4px 12px rgba(0,0,0,0.05)}
*{box-sizing:border-box}html,body{margin:0}
body{font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:var(--fg);background:#fff;-webkit-font-smoothing:antialiased}
button{font:inherit;cursor:pointer}img{display:block;max-width:100%}
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:12px 16px;padding-top:calc(12px + env(safe-area-inset-top));background:rgba(255,255,255,.95);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{font-weight:800;font-size:18px;color:var(--acc);letter-spacing:-.5px}
.cart-btn{position:relative;border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 14px;font-size:15px;display:flex;align-items:center;gap:6px;font-weight:600}
.badge{background:var(--acc);color:#fff;border-radius:999px;font-size:11px;min-width:18px;height:18px;display:grid;place-items:center;padding:0 5px}
.search{padding:12px 16px 0}
.search input{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--soft);font-size:15px;outline:none;transition:.2s}
.search input:focus{border-color:var(--acc);background:#fff;box-shadow:0 0 0 3px rgba(46,125,50,0.1)}
.cats{display:flex;gap:8px;overflow-x:auto;padding:12px 16px;scrollbar-width:none}
.cats::-webkit-scrollbar{display:none}
.chip{white-space:nowrap;border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 14px;font-size:14px;color:var(--muted);font-weight:500}
.chip.on{background:var(--acc);color:#fff;border-color:var(--acc);box-shadow:0 2px 8px rgba(46,125,50,0.2)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:0 16px 40px}
.card{border:1px solid var(--line);border-radius:var(--rad);overflow:hidden;display:flex;flex-direction:column;background:#fff;box-shadow:var(--shadow)}
.thumb{aspect-ratio:1/1;background:var(--soft);position:relative}
.thumb img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.card-body{padding:12px;display:flex;flex-direction:column;gap:6px;flex:1}
.card h3{margin:0;font-size:15px;line-height:1.3;font-weight:700}
.card .desc{margin:0;font-size:13px;color:var(--muted);line-height:1.3}
.card-foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:8px;padding-top:10px}
.card-foot b{font-size:16px;color:var(--acc)}
.add{border:0;background:var(--acc);color:#fff;border-radius:10px;padding:8px 12px;font-size:13px;font-weight:600;transition:.2s}
.add:active{transform:scale(0.95)}
.overlay{position:fixed;inset:0;background:rgba(27,38,44,.5);z-index:40;backdrop-filter:blur(2px)}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(92vw,400px);background:#fff;z-index:50;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s cubic-bezier(0.4, 0, 0.2, 1);padding-top:env(safe-area-inset-top);box-shadow:-5px 0 25px rgba(0,0,0,0.1)}
.drawer.open{transform:none}
.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--line)}
.drawer-head h2{margin:0;font-size:18px}
.icon{border:0;background:transparent;font-size:20px;color:var(--muted);padding:4px 8px}
.cart-items{flex:1;overflow:auto;padding:8px 16px}
.ci{display:flex;gap:12px;padding:16px 0;border-bottom:1px solid var(--line)}
.ci img{width:64px;height:64px;border-radius:10px;object-fit:cover;background:var(--soft)}
.ci-main{flex:1;min-width:0}
.ci-main h4{margin:0 0 4px;font-size:14px;font-weight:600}
.muted{font-size:13px;color:var(--muted)}
.qty{display:flex;align-items:center;gap:10px;margin-top:8px}
00:46
.qty button{width:30px;height:30px;border-radius:8px;border:1px solid var(--line);background:#fff;font-weight:600;font-size:16px}
.del{border:0;background:transparent;color:#e53935;font-size:13px;padding:0;margin-top:6px;font-weight:500}
.drawer-foot{padding:16px;border-top:1px solid var(--line);padding-bottom:calc(16px + env(safe-area-inset-bottom));background:var(--soft)}
.total{display:flex;justify-content:space-between;margin-bottom:12px;font-size:18px}
.total b{color:var(--acc)}
.btn{width:100%;border:0;border-radius:12px;padding:16px;font-size:16px;font-weight:700;transition:.2s}
.btn.primary{background:var(--acc);color:#fff;box-shadow:0 4px 12px rgba(46,125,50,0.2)}
.btn.primary:active{transform:scale(0.98)}
.btn:disabled{opacity:.6;box-shadow:none;transform:none}
.modal{position:fixed;inset:0;z-index:60;background:rgba(27,38,44,.6);display:flex;align-items:flex-end;backdrop-filter:blur(2px)}
.sheet{width:100%;max-height:92vh;overflow:auto;background:#fff;border-radius:24px 24px 0 0;padding-bottom:calc(24px + env(safe-area-inset-bottom))}
.sheet label{display:block;padding:12px 16px 0;font-size:13px;color:var(--muted);font-weight:500}
.sheet input,.sheet textarea{width:100%;margin-top:6px;padding:14px;border:1px solid var(--line);border-radius:12px;font-size:15px;font-family:inherit;background:var(--soft);outline:none;transition:.2s}
.sheet input:focus,.sheet textarea:focus{background:#fff;border-color:var(--acc);box-shadow:0 0 0 3px rgba(46,125,50,0.1)}
.summary{margin:16px;padding:16px;border-radius:12px;background:var(--soft);font-size:14px;white-space:pre-wrap;line-height:1.5}
.sheet .btn{margin:0 16px;width:calc(100% - 32px)}
.hint{padding:12px 16px 0;font-size:13px;color:var(--muted);text-align:center}
.links{display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px 0}
.links a,.links button{flex:1;min-width:140px;text-align:center;border:1px solid var(--line);background:#fff;border-radius:12px;padding:14px;font-size:14px;text-decoration:none;color:var(--fg);font-weight:600}
.empty{text-align:center;color:var(--muted);padding:40px 16px}
@media(min-width:640px){.grid{grid-template-columns:repeat(3,1fr)}.top{padding:16px 24px}.grid{padding:0 24px 40px}.search{padding:16px 24px 0}.cats{padding:16px 24px}}
</style>
</head>
<body>

<header class="top">
  <div class="brand" id="brand">🐾  Здоровое питание</div>
  <button class="cart-btn" id="cartBtn">Корзина <span class="badge" id="cartCount">0</span></button>
</header>

<main>
  <section class="search"><input id="q" type="search" placeholder="Поиск лакомств и витаминов..." autocomplete="off"></section>
  <nav class="cats" id="cats"></nav>
  <section class="grid" id="grid"></section>
  <p class="empty" id="empty" hidden>По вашему запросу ничего не найдено</p>
</main>

<div class="overlay" id="overlay" hidden></div>

<aside class="drawer" id="drawer">
  <div class="drawer-head"><h2>Ваша корзина</h2><button class="icon" id="closeDrawer">✕</button></div>
  <div id="cartItems" class="cart-items"></div>
  <div class="drawer-foot">
    <div class="total">Итого: <b id="total">0 ₽</b></div>
    <button class="btn primary" id="checkoutBtn">Перейти к оформлению</button>
  </div>
</aside>

<div class="modal" id="modal" hidden>
  <form id="orderForm" class="sheet">
    <div class="drawer-head"><h2>Оформление заказа</h2><button type="button" class="icon" id="closeModal">✕</button></div>
    <label>Ваше имя<input name="name" required autocomplete="name" placeholder="Иван"></label>
    <label>Телефон или Telegram<input name="contact" required placeholder="+7 (999) 000-00-00 или @ник"></label>
    <label>Адрес доставки или самовывоз<textarea name="address" rows="2" placeholder="Город, улица, дом, квартира"></textarea></label>
    <label>Комментарий к заказу<textarea name="comment" rows="2" placeholder="Например: позвонить за час"></textarea></label>
    <div class="summary" id="orderSummary"></div>
    <button class="btn primary" type="submit" id="submitBtn">Подтвердить заказ</button>
00:46
<p class="hint" id="orderHint"></p>
    <div class="links" id="orderLinks"></div>
  </form>
</div>

<script>
const CONFIG = {
  shopName: "🐾  Здоровое питание",
  currency: "₽",
  email: "", 
  whatsapp: "", 
  telegram: "" 
};

const PRODUCTS = [
  {id:"d1", name:"Сушка из индейки", price:450, category:"Сушка", photo:"https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=600&q=80", desc:"Натуральное лакомство, 100 г"},
  {id:"d2", name:"Лакомство «Печень»", price:320, category:"Лакомства", photo:"https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=600&q=80", desc:"Сублимированная печень, 50 г"},
  {id:"d3", name:"Витамины для шерсти", price:890, category:"Витамины", photo:"https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=600&q=80", desc:"С рыбьим жиром, 60 капсул"},
  {id:"d4", name:"Травяной сбор «Спокойствие»", price:280, category:"Здоровье", photo:"https://images.unsplash.com/photo-1514733670139-4d87a1941d55?w=600&q=80", desc:"Успокаивающий чай, 50 г"},
  {id:"d5", name:"Кость из жил", price:390, category:"Лакомства", photo:"https://images.unsplash.com/photo-1576201836106-db1758fd1c97?w=600&q=80", desc:"Долгоиграющее лакомство"},
  {id:"d6", name:"Масло лосося", price:1200, category:"Витамины", photo:"https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=600&q=80", desc:"Для блеска шерсти, 250 мл"}
];

const $=(s,r=document)=>r.querySelector(s);
const money=n=>n.toLocaleString("ru-RU")+"\u00A0"+CONFIG.currency;
const findProduct=id=>PRODUCTS.find(p=>p.id===id);
const KEY="shop_cart_v3";
let cart=[];try{cart=JSON.parse(localStorage.getItem(KEY)||"[]");}catch{cart=[];}
const saveCart=()=>localStorage.setItem(KEY,JSON.stringify(cart));
const cartCount=()=>cart.reduce((s,i)=>s+i.qty,0);
const cartSum=()=>cart.reduce((s,i)=>s+((findProduct(i.id)||{}).price||0)*i.qty,0);

function addToCart(id){const it=cart.find(i=>i.id===id);if(it)it.qty++;else cart.push({id,qty:1});saveCart();renderCart();openDrawer();}
function setQty(id,d){const it=cart.find(i=>i.id===id);if(!it)return;it.qty+=d;if(it.qty<=0)cart=cart.filter(i=>i.id!==id);saveCart();renderCart();}
function removeItem(id){cart=cart.filter(i=>i.id!==id);saveCart();renderCart();}

let activeCat="all",query="";
function renderCats(){const cats=["all",...new Set(PRODUCTS.map(p=>p.category).filter(Boolean))];$("#cats").innerHTML=cats.map(c=>`<button class="chip ${c===activeCat?"on":""}" data-cat="${c}">${c==="all"?"Все товары":c}</button>`).join("");}
function visibleProducts(){const q=query.trim().toLowerCase();return PRODUCTS.filter(p=>(activeCat==="all"||p.category===activeCat)&&(!q||(p.name+" "+(p.desc||"")).toLowerCase().includes(q)));}
function renderGrid(){const list=visibleProducts();$("#grid").innerHTML=list.map(p=>`<article class="card"><div class="thumb"><img src="${p.photo}" alt="${p.name}" loading="lazy"></div><div class="card-body"><h3>${p.name}</h3>${p.desc?`<p class="desc">${p.desc}</p>`:""}<div class="card-foot"><b>${money(p.price)}</b><button class="add" data-add="${p.id}">В корзину</button></div></div></article>`).join("");$("#empty").hidden=list.length>0;}
function renderCart(){const box=$("#cartItems");if(!cart.length){box.innerHTML=`<p class="empty">Ваша корзина пока пуста</p>`;}else{box.innerHTML=cart.map(i=>{const p=findProduct(i.id);if(!p)return"";return`<div class="ci"><img src="${p.photo}" alt=""><div class="ci-main"><h4>${p.name}</h4><div class="muted">${money(p.price)}</div><div class="qty"><button data-qty="-1" data-id="${p.id}">−</button><span>${i.qty}</span><button data-qty="1" data-id="${p.id}">+</button></div><button class="del" data-del="${p.id}">Удалить</button></div><b>${money(p.price*i.qty)}</b></div>`;}).join("");}$("#total").textContent=money(cartSum());$("#checkoutBtn").disabled=cart.length===0;$("#cartCount").textContent=cartCount();}

function openDrawer(){$("#drawer").classList.add("open");$("#overlay").hidden=false;}
00:46
function closeDrawer(){$("#drawer").classList.remove("open");if($("#modal").hidden)$("#overlay").hidden=true;}
function openModal(){if(!cart.length)return;$("#orderSummary").textContent=orderText();$("#orderHint").textContent="";$("#orderLinks").innerHTML="";$("#modal").hidden=false;$("#overlay").hidden=false;closeDrawer();}
function closeModal(){$("#modal").hidden=true;$("#overlay").hidden=true;}

function orderText(c={}){const L=["Новый заказ",""];cart.forEach(i=>{const p=findProduct(i.id);if(p)L.push(`• ${p.name} × ${i.qty} = ${money(p.price*i.qty)}`);});L.push("",`Итого: ${money(cartSum())}`);if(c.name)L.push("",`Имя: ${c.name}`);if(c.contact)L.push(`Связь: ${c.contact}`);if(c.address)L.push(`Доставка: ${c.address}`);if(c.comment)L.push(`Комментарий: ${c.comment}`);return L.join("\n");}

function showLinks(text){const enc=encodeURIComponent(text);const links=[];if(CONFIG.whatsapp)links.push(`<a href="https://wa.me/${CONFIG.whatsapp}?text=${enc}" target="_blank" rel="noopener">WhatsApp</a>`);if(CONFIG.telegram)links.push(`<a href="https://t.me/share/url?url=${encodeURIComponent(location.href)}&text=${enc}" target="_blank" rel="noopener">Telegram</a>`);links.push(`<button id="copyOrder">Скопировать текст</button>`);$("#orderLinks").innerHTML=links.join("");const c=$("#copyOrder");if(c)c.onclick=async()=>{try{await navigator.clipboard.writeText(text);c.textContent="Скопировано ✓";}catch{}};}

$("#orderForm").addEventListener("submit",async e=>{
  e.preventDefault();
  const fd=new FormData(e.target);const c={name:fd.get("name"),contact:fd.get("contact"),address:fd.get("address"),comment:fd.get("comment")};
  const text=orderText(c);const btn=$("#submitBtn");
  btn.disabled=true;btn.textContent="Отправляем...";let sent=false;
  if(CONFIG.email){
    try{
      const r=await fetch("https://formsubmit.co/ajax/"+encodeURIComponent(CONFIG.email),{
        method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},
        body:JSON.stringify({_subject:"Новый заказ с сайта — "+CONFIG.shopName,"Имя":c.name,"Связь":c.contact,"Доставка":c.address,"Комментарий":c.comment,"Заказ":text})
      });sent=r.ok;
    }catch{sent=false;}
  }
  btn.disabled=false;btn.textContent="Подтвердить заказ";
  $("#orderHint").textContent=sent?"Заказ успешно отправлен! Мы свяжемся с вами.":"Заказ не ушел автоматически. Отправьте его через мессенджер:";
  if(sent){cart=[];saveCart();renderCart();e.target.reset();}
  showLinks(text);
});

$("#brand").textContent=CONFIG.shopName;document.title=CONFIG.shopName;
$("#grid").addEventListener("click",e=>{const b=e.target.closest("[data-add]");if(b)addToCart(b.dataset.add);});
$("#cats").addEventListener("click",e=>{const b=e.target.closest("[data-cat]");if(!b)return;activeCat=b.dataset.cat;renderCats();renderGrid();});
$("#q").addEventListener("input",e=>{query=e.target.value;renderGrid();});
$("#cartItems").addEventListener("click",e=>{const q=e.target.closest("[data-qty]");if(q)return setQty(q.dataset.id,+q.dataset.qty);const d=e.target.closest("[data-del]");if(d)removeItem(d.dataset.del);});
$("#cartBtn").addEventListener("click",openDrawer);
$("#closeDrawer").addEventListener("click",closeDrawer);
$("#closeModal").addEventListener("click",closeModal);
$("#overlay").addEventListener("click",()=>{closeDrawer();closeModal();});
$("#checkoutBtn").addEventListener("click",openModal);
renderCats();renderGrid();renderCart();
</script>
</body>
</html>
